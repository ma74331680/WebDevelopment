@model ArtworkCreateVm
@{
    ViewData["Title"] = "上傳作品";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="upload-form">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="form-group">
        <label>作品圖片 (PNG / JPEG / WEBP)</label>
        <input id="imageInput" type="file" name="image" accept="image/png,image/jpeg,image/webp" class="form-control" />
        @Html.ValidationMessage("image", new { @class = "text-danger" })
    </div>

    <div id="preview" class="preview-box" style="display:none;">
        <img id="previewImg" alt="預覽圖" />
    </div>

    <button type="submit" class="btn btn-primary">上傳</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // 簡易前端預覽
        const input = document.getElementById('imageInput');
        const box = document.getElementById('preview');
        const img = document.getElementById('previewImg');
        input.addEventListener('change', e => {
            const f = e.target.files && e.target.files[0];
            if (!f) { box.style.display = 'none'; return; }
            const url = URL.createObjectURL(f);
            img.src = url;
            box.style.display = 'block';
        });
    </script>
}

<style>
    .upload-form { max-width: 640px; }
    .preview-box { margin: 12px 0; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden; }
    .preview-box img { display:block; width:100%; height:auto; }
</style>
