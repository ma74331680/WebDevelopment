@model IEnumerable<Artwork>
@{
    ViewData["Title"] = "最新作品";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <div class="empty-tip">
        目前還沒有作品
    </div>
}
else
{
    <div class="art-grid">
        @foreach (var a in Model)
        {
            @Html.Partial("_ArtworkCard", a)
        }
    </div>
}
